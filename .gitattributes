# Git Attributes for Aphrodite Engine (cogpy/aphroditecho)
# 
# LFS POLICY: Only track files >50MB that are actual ML model weights.
# Small media files (images, docs, audio) should be committed directly.
# Architecture diagrams, documentation assets, and example files are
# small enough to store in the repository without LFS.
#
# KSM Evolution Cycle 13: Removed broken LFS tracking for all media files.
# All 25 LFS objects were missing from the server (404), blocking CI/CD.

# AI/ML Model Files (>50MB only - these should not be committed to the repo)
*.bin filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text

# Linguist overrides
*.py linguist-language=Python
*.jl linguist-language=Julia
*.scm linguist-language=Scheme
